{
  "name": "@alphabros/themes",
  "version": "0.0.0-development",
  "private": true,
  "description": "Planned framework-agnostic theme tooling: token contracts, validation, adapters and editor.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShipFast-Syndicate/themes.git"
  },
  "homepage": "https://github.com/ShipFast-Syndicate/themes#readme",
  "bugs": {
    "url": "https://github.com/ShipFast-Syndicate/themes/issues"
  },
  "author": "Alpha Bros (https://alphabros.eu)",
  "scripts": {
    "check": "node .github/scripts/check-bootstrap.mjs",
    "clean": "node .github/scripts/clean-dist.mjs",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run clean && npm run build",
    "check:package": "node .github/scripts/check-package.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
